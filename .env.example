# Copier en .env et compléter. Ne jamais commiter le .env.

# --- Serveur ---
BASE_PUBLIC_URL=https://api.creatoke.fr
JWT_SECRET=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Facturation / emails ---
SELLER_NAME=
SELLER_ADDRESS=
SELLER_SIRET=
SELLER_EMAIL=
PROSPECT_SMTP_USER=
PROSPECT_SMTP_PASSWORD=

# --- Publication des vidéos (page « Publier une vidéo » et assistant IA) ---
# Tout passe par Upload-Post (app.upload-post.com) : les réseaux (Instagram, TikTok, YouTube,
# Facebook, LinkedIn, X, Threads, Bluesky) se connectent depuis son tableau de bord, pas ici.
# Vérification sans rien publier : npm run social:check
UPLOAD_POST_API_KEY=
# Profil Upload-Post sur lequel les réseaux sont connectés (facultatif s'il n'y en a qu'un)
UPLOAD_POST_USER=
# Page Facebook « Creatoke » (obligatoire : le compte Facebook connecté gère plusieurs Pages)
UPLOAD_POST_FACEBOOK_PAGE_ID=1409146282635086
# Facultatif : Page LinkedIn « Créatoké » (109201039) ; vide = profil LinkedIn personnel connecté
UPLOAD_POST_LINKEDIN_PAGE_ID=
# Facebook : VIDEO (vidéo sur la Page, par défaut) ou REELS (90 secondes maximum)
UPLOAD_POST_FACEBOOK_MEDIA_TYPE=VIDEO
# YouTube : public | unlisted | private
YOUTUBE_PRIVACY=public

# Bilan mensuel des ventes par e-mail (le 1er du mois, bilan du mois précédent).
# Destinataires séparés par des virgules ; vide = tous les comptes administrateurs.
MONTHLY_REPORT_TO=
# Heure de vérification quotidienne (cron, heure de Paris) ; « off » pour désactiver.
MONTHLY_REPORT_CRON=0 8 * * *
