# Copier en .env et compléter. Ne jamais commiter le .env.

# --- Serveur ---
BASE_PUBLIC_URL=https://api.creatoke.fr
JWT_SECRET=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Facturation / emails ---
SELLER_NAME=
SELLER_ADDRESS=
SELLER_SIRET=
SELLER_EMAIL=
PROSPECT_SMTP_USER=
PROSPECT_SMTP_PASSWORD=

# --- Publication des vidéos (page « Publier une vidéo ») ---
# Un réseau sans ses variables est ignoré. Vérification sans rien publier : npm run social:check

# Instagram (Reel) : compte professionnel relié à la Page Facebook
IG_USER_ID=
FB_ACCESS_TOKEN=

# Facebook : vidéo sur la Page. Jeton de Page avec pages_manage_posts (à défaut, FB_ACCESS_TOKEN)
FB_PAGE_ID=1409146282635086
FB_PAGE_ACCESS_TOKEN=

# YouTube : client OAuth Google Cloud (YouTube Data API v3), puis : npm run social:auth youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public

# Bluesky : mot de passe d'application (Paramètres → Mots de passe d'application)
BLUESKY_EMAIL=
BLUESKY_PASSWORD=

# LinkedIn : app LinkedIn (produits « Share on LinkedIn » + « Sign In with OpenID Connect »),
# URL de redirection http://localhost:53682/callback, puis : npm run social:auth linkedin
# Le jeton expire au bout de 60 jours.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Version d'API LinkedIn (AAAAMM), à avancer si LinkedIn la déclare obsolète
LINKEDIN_API_VERSION=

# X (Twitter) : app du portail développeur X, droits « Read and write »,
# puis « Keys and tokens » → API Key/Secret et Access Token/Secret (OAuth 1.0a)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
